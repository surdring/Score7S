<!--pages/history/history.wxml-->
<view class="container">
  <!-- 顶部Header - 卡片式蓝紫渐变 -->
  <view class="header">
    <view class="header-content">
      <!-- 左侧标题 -->
      <view class="header-title-area">
        <text class="header-main-title">评分记录查询</text>
        <text class="header-subtitle">支持关键词检索与一键导出</text>
      </view>
    </view>
    
    <!-- 搜索框 - 胶囊半透明 -->
    <view class="search-box">
      <view class="search-icon"></view>
      <input 
        class="search-input"
        placeholder="搜索部门、检查员..."
        placeholder-style="color: rgba(255,255,255,0.6); font-size: 28rpx; letter-spacing: 1rpx;"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>
    
    <!-- 筛选行：日期 + 导出 -->
    <view class="filter-row">
      <view class="date-picker">
        <view class="picker-icon"></view>
        <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
          <view class="picker-value {{selectedDate ? '' : 'placeholder'}}">{{selectedDate || '选择日期'}}</view>
        </picker>
        <text class="picker-arrow">▾</text>
      </view>
      <view 
        class="export-btn-light {{filteredInspections.length === 0 || exporting ? 'disabled' : ''}}"
        bindtap="exportData"
      >
        <view class="export-icon"></view>
        <text>导出</text>
      </view>
      <view class="admin-btn-light" bindtap="goToAdmin">
        <view class="admin-icon"></view>
        <text>管理</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
  </view>

  <!-- 无数据 - 线性插画风格 -->
  <view wx:elif="{{filteredInspections.length === 0}}" class="empty-state">
    <view class="empty-illustration">
      <view class="folder-icon"></view>
      <view class="search-line"></view>
    </view>
    <text class="empty-text">暂无历史记录</text>
    <text class="empty-hint">当前日期范围内没有检查数据</text>
  </view>

  <!-- 列表 -->
  <view wx:else class="list">
    <view 
      wx:for="{{filteredInspections}}" 
      wx:key="_id" 
      class="list-item {{item.totalScore === 100 ? 'perfect' : (item.totalScore >= 80 ? 'good' : 'normal')}}"
      bindtap="viewDetail"
      data-id="{{item._id}}"
    >
      <!-- 左侧色条 -->
      <view class="color-bar {{item.totalScore === 100 ? 'perfect' : (item.totalScore >= 80 ? 'good' : 'normal')}}"></view>
      
      <view class="item-content">
        <text class="item-room">{{item.room}}</text>
        <text class="item-dept">{{item.department}}</text>
        <view class="item-meta">
          <text>{{item.date}}</text>
          <text class="meta-dot">•</text>
          <text>{{item.checkerName || '匿名检查员'}}</text>
        </view>
      </view>
      
      <view class="item-right">
        <view class="score-section">
          <text class="item-score {{item.totalScore === 100 ? 'perfect' : (item.totalScore >= 80 ? 'good' : 'normal')}}">{{item.totalScore}}</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>
</view>

<view 
  wx:if="{{showPasswordModal}}" 
  class="modal-mask" 
  catchtouchmove="preventTouchMove"
>
  <view class="password-modal" catchtap="">
    <view class="password-modal-header">
      <text class="password-modal-title">管理入口验证</text>
      <view class="modal-close" bindtap="cancelPasswordModal">✕</view>
    </view>
    <view class="password-modal-body">
      <text class="password-hint">请输入管理密码</text>
      <input 
        class="password-input"
        type="password"
        placeholder="请输入密码"
        value="{{passwordInput}}"
        bindinput="onPasswordInput"
        focus="{{passwordInputFocus}}"
        adjust-position="{{false}}"
      />
    </view>
    <view class="password-modal-footer">
      <button class="btn-cancel" bindtap="cancelPasswordModal">取消</button>
      <button class="btn-confirm" bindtap="confirmPassword" loading="{{passwordVerifying}}">确认</button>
    </view>
  </view>
</view>

<!-- 详情弹窗 -->
<view wx:if="{{showDetail}}" class="modal-mask" bindtap="closeDetail">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <view class="modal-title">
        <text class="modal-dept">{{selectedInspection.department}}</text>
        <text class="modal-subtitle">{{selectedInspection.room}} - {{selectedInspection.date}}</text>
      </view>
      <view class="modal-close" bindtap="closeDetail">✕</view>
    </view>

    <view class="modal-score">
      <text class="score-label">总分</text>
      <text class="score-value">{{selectedInspection.totalScore}}分</text>
    </view>

    <scroll-view scroll-y class="modal-body">
      <text class="detail-title">评分明细</text>
      <view class="detail-list">
        <view wx:for="{{selectedInspection.details}}" wx:key="item" class="detail-card">
          <view class="detail-header">
            <text class="detail-item">{{item.item}}</text>
            <text class="detail-score {{item.score === scoringMaxScores[item.item] ? 'success' : 'danger'}}">{{item.score}}分</text>
          </view>
          <view wx:if="{{item.remark}}" class="detail-remark">
            <text>{{item.remark}}</text>
          </view>
          <view wx:if="{{item.images.length > 0}}" class="detail-images">
            <image 
              wx:for="{{item.images}}" 
              wx:for-item="img" 
              wx:for-index="idx"
              wx:key="idx"
              src="{{img}}" 
              class="detail-image"
              mode="aspectFill"
              bindtap="previewImage"
              data-url="{{img}}"
              data-urls="{{item.images}}"
            />
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
