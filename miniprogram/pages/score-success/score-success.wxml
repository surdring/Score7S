<!--pages/score-success/score-success.wxml-->
<view class="container">
  <view class="success-card">
    <view class="success-icon">✓</view>
    <text class="success-title">提交成功</text>
    
    <view wx:if="{{inspection}}" class="success-info">
      <text class="info-dept">{{inspection.department}}</text>
      <text class="info-room">{{inspection.room}}</text>
      <view class="info-score">
        <text class="score-label">总分:</text>
        <text class="score-value">{{inspection.totalScore}}</text>
        <text class="score-unit">分</text>
      </view>
    </view>

    <view class="actions">
      <button class="action-btn primary" bindtap="viewDetail">查看详情</button>
      <button class="action-btn secondary" bindtap="goHome">返回首页</button>
      <button class="action-btn text" bindtap="continueScore">继续打分</button>
    </view>
  </view>
</view>
