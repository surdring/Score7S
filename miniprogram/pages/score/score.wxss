/* pages/score/score.wxss */

.page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 头部 */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #FFFFFF;
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid #E5E7EB;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 已删除头部标题和已评文字样式 */
.header-title,
.progress-text {
  display: none;
}

/* 胶囊式选择器 */
.capsule-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.capsule-row:last-child {
  margin-bottom: 0;
}

.capsule-half {
  flex: 1;
  min-width: 0;
}

.capsule-full {
  flex: 1;
}

.capsule-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #F3F4F6;
  border-radius: 32rpx;
  padding: 16rpx 20rpx;
  transition: all 0.2s;
}

.capsule-btn:active {
  background-color: #E5E7EB;
  transform: scale(0.98);
}

.capsule-btn-static {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #F9FAFB;
  border-radius: 32rpx;
  padding: 16rpx 20rpx;
}

.capsule-date .capsule-btn-static {
  border: 1rpx solid #E5E7EB;
}

.capsule-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.capsule-text {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capsule-arrow {
  font-size: 24rpx;
  color: #9CA3AF;
  flex-shrink: 0;
  margin-left: 4rpx;
}

/* 底部进度条（已删除） */
.progress-bar,
.progress-fill,
.progress-text-overlay {
  display: none;
}

/* 评分列表 */
.score-list {
  padding: 24rpx 32rpx;
}

.score-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.score-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.score-number {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #DBEAFE;
  color: #3B82F6;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
}

.score-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

/* 评分标准提示 */
.score-title-wrap {
  flex: 1;
}

.score-standard {
  display: block;
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* 分数输入区 */
.score-input-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.score-hints {
  flex: 1;
}

.score-max {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 500;
}

/* 步进器 */
.stepper-container {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stepper-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F3F4F6;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.stepper-btn:active {
  background-color: #E5E7EB;
  transform: scale(0.95);
}

.stepper-btn.disabled {
  background-color: #F9FAFB;
  opacity: 0.4;
}

.stepper-icon {
  font-size: 32rpx;
  color: #374151;
  font-weight: 600;
  line-height: 1;
}

.stepper-input {
  width: 100rpx;
  height: 72rpx;
  padding: 0 12rpx;
  background-color: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  text-align: center;
  box-sizing: border-box;
}

.stepper-input:focus {
  border-color: #3B82F6;
  background-color: #FFFFFF;
}

.stepper-input.error {
  border-color: #EF4444;
  background-color: #FEF2F2;
  color: #DC2626;
}

/* 快捷标签 */
.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.quick-tag {
  padding: 12rpx 20rpx;
  background-color: #F3F4F6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #4B5563;
  transition: all 0.2s;
}

.quick-tag:active {
  background-color: #E5E7EB;
  transform: scale(0.98);
}

.quick-tag.active {
  background-color: #DBEAFE;
  color: #3B82F6;
  font-weight: 500;
}

/* 备注输入 */
.remark-input {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  padding: 16rpx 20rpx;
  background-color: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #111827;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  transition: all 0.2s;
}

.remark-input.required {
  border-color: #EF4444;
  background-color: #FEF2F2;
}

.remark-input.required::placeholder {
  color: #DC2626;
  font-weight: 500;
}

/* 必填项抖动动画 */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-4rpx); }
  20%, 40%, 60%, 80% { transform: translateX(4rpx); }
}

.shake-animation {
  animation: shake 0.4s ease-in-out;
}

/* 图片上传 */
.image-upload {
  margin-bottom: 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 2rpx solid #E5E7EB;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 20rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #F9FAFB;
  border: 4rpx dashed #D1D5DB;
  border-radius: 12rpx;
}

.upload-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 警告提示 */
.warning-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #DC2626;
}

.warning-icon {
  font-size: 28rpx;
}

/* 提交栏 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 2rpx solid #E5E7EB;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.total-score {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-right: 8rpx;
}

.total-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #3B82F6;
}

.total-unit {
  font-size: 24rpx;
  color: #6B7280;
  margin-left: 4rpx;
}

.submit-btn {
  background-color: #3B82F6;
  color: #FFFFFF;
  padding: 24rpx 64rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.submit-btn.disabled {
  background-color: #E5E7EB;
  color: #9CA3AF;
}

/* 成功页 */
.success-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 32rpx;
}

.success-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 64rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  max-width: 600rpx;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #D1FAE5;
  color: #10B981;
  border-radius: 50%;
  font-size: 64rpx;
  margin: 0 auto 32rpx;
}

.success-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.success-info {
  display: block;
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 32rpx;
}

.success-score {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 48rpx;
}

.success-score .score-label {
  font-size: 28rpx;
  color: #6B7280;
}

.success-score .score-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #3B82F6;
  margin: 0 8rpx;
}

.success-score .score-unit {
  font-size: 28rpx;
  color: #6B7280;
}

.success-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.action-btn.primary {
  background-color: #DBEAFE;
  color: #3B82F6;
}

.action-btn.secondary {
  background-color: #F3F4F6;
  color: #374151;
}

.action-btn.text {
  background-color: transparent;
  color: #9CA3AF;
  font-size: 28rpx;
}
