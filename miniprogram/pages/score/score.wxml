<!--pages/score/score.wxml-->
<view wx:if="{{!submitted}}" class="page">
  <!-- 头部信息 - 卡片式蓝紫渐变 -->
  <view class="header">
    <!-- 标题区域 -->
    <view class="header-title-area">
      <text class="header-main-title">7S评分表单</text>
      <text class="header-subtitle">按标准逐项评分，低分需备注或拍照</text>
    </view>
    <!-- 胶囊式选择器 -->
    <view class="capsule-row">
      <view class="capsule-half capsule-date">
        <view class="capsule-btn-static">
          <view class="capsule-icon"></view>
          <text class="capsule-text">{{date}}</text>
        </view>
      </view>
      <view class="capsule-half">
        <picker 
          mode="selector" 
          range="{{departments}}" 
          range-key="name" 
          value="{{deptIndex}}"
          bindchange="onDeptChange"
        >
          <view class="capsule-btn">
            <view class="capsule-icon"></view>
            <text class="capsule-text">{{selectedDept || '选择部门'}}</text>
            <text class="capsule-arrow">▾</text>
          </view>
        </picker>
      </view>
    </view>
    
    <view class="capsule-row">
      <view class="capsule-full">
        <picker 
          mode="selector" 
          range="{{departments[deptIndex].rooms}}" 
          value="{{roomIndex}}"
          bindchange="onRoomChange"
        >
          <view class="capsule-btn">
            <view class="capsule-icon"></view>
            <text class="capsule-text">{{selectedRoom || '选择办公室'}}</text>
            <text class="capsule-arrow">▾</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
  </view>

  <!-- 评分表单 -->
  <view wx:else class="score-list">
    <view 
      wx:for="{{scoringItems}}" 
      wx:key="*this" 
      class="score-card score-item"
      data-item="{{item}}"
      id="item-{{item}}"
    >
      <view class="score-header">
        <view class="score-icon"></view>
        <view class="score-title-wrap">
          <text class="score-title">{{item}}</text>
          <text class="score-standard">{{scoringStandards[item]}}</text>
        </view>
      </view>

      <!-- 分数输入区 - 步进器+输入框 -->
      <view class="score-input-section">
        <view class="score-hints">
          <text class="score-max">最高分：{{scoringMaxScores[item]}}分</text>
        </view>
        
        <!-- 步进器 -->
        <view class="stepper-container">
          <view 
            class="stepper-btn {{scores[item].score === null || scores[item].score <= 0 ? 'disabled' : ''}}"
            bindtap="decreaseScore"
            data-item="{{item}}"
          >
            <text class="stepper-icon">−</text>
          </view>
          <input
            class="stepper-input {{scores[item].score > scoringMaxScores[item] ? 'error' : ''}}"
            type="number"
            placeholder="0"
            value="{{scores[item].score}}"
            bindinput="onScoreInput"
            bindblur="onScoreBlur"
            data-item="{{item}}"
          />
          <view 
            class="stepper-btn {{scores[item].score !== null && scores[item].score >= scoringMaxScores[item] ? 'disabled' : ''}}"
            bindtap="increaseScore"
            data-item="{{item}}"
          >
            <text class="stepper-icon">+</text>
          </view>
        </view>
      </view>

      <!-- 快捷标签 -->
      <view class="quick-tags">
        <view 
          wx:for="{{quickTags[scoringMaxScores[item]]}}"
          wx:for-item="tag"
          wx:key="value"
          class="quick-tag {{scores[item].score === tag.value ? 'active' : ''}}"
          bindtap="onQuickTagTap"
          data-item="{{item}}"
          data-value="{{tag.value}}"
          data-percent="{{tag.percent}}"
        >
          {{tag.label}}
        </view>
      </view>

      <!-- 备注输入 -->
      <textarea 
        class="remark-input {{isLowScore(item) ? 'required' : ''}}"
        placeholder="{{isLowScore(item) ? '请填写扣分原因（必填）...' : '备注说明（选填）...'}}"
        value="{{scores[item].remark}}"
        bindinput="onRemarkInput"
        data-item="{{item}}"
      />

      <!-- 图片上传 -->
      <view class="image-upload">
        <view class="image-list">
          <view 
            wx:for="{{scores[item].images}}" 
            wx:for-item="img" 
            wx:for-index="idx"
            wx:key="idx"
            class="image-item"
          >
            <image 
              src="{{img}}" 
              mode="aspectFill" 
              class="preview-image"
              bindtap="previewImage"
              data-url="{{img}}"
              data-item="{{item}}"
            />
            <view 
              class="delete-btn"
              bindtap="deleteImage"
              data-item="{{item}}"
              data-index="{{idx}}"
            >✕</view>
          </view>

          <view 
            wx:if="{{scores[item].images.length < 3}}"
            class="upload-btn"
            bindtap="chooseImage"
            data-item="{{item}}"
          >
            <view class="upload-icon"></view>
            <text class="upload-text">拍照/相册({{scores[item].images.length}}/3)</text>
          </view>
        </view>
      </view>

      <!-- 低分提示 -->
      <view 
        wx:if="{{isLowScore(item) && !scores[item].remark && scores[item].images.length === 0}}"
        class="warning-tip"
      >
        <text class="warning-icon">⚠</text>
        <text>评分≤{{scoringLowThresholds[item]}}分，必须上传照片或填写备注</text>
      </view>
    </view>
  </view>

  <!-- 底部提交栏 -->
  <view class="submit-bar {{scoredCount < 7 ? 'incomplete' : 'ready'}}">
    <view class="bar-left-zone">
      <view class="total-score">
        <text class="total-label">当前总评分</text>
        <view class="score-container">
          <text class="total-value">{{totalScore}}</text>
          <text class="total-unit">分</text>
        </view>
      </view>
      <!-- 垂直分割线 -->
      <view class="v-divider"></view>
    </view>

    <button 
      class="submit-btn {{submitting || scoredCount < 7 ? 'disabled' : ''}}"
      bindtap="submit"
      disabled="{{submitting || scoredCount < 7}}"
    >
      <view class="btn-content">
        <text wx:if="{{submitting}}">提交中...</text>
        <block wx:elif="{{scoredCount < 7}}">
          <text class="btn-sub-text">剩余{{7 - scoredCount}}项</text>
        </block>
        <text wx:else>提交评分</text>
      </view>
    </button>
  </view>
</view>

<!-- 提交成功页 -->
<view wx:if="{{submitted}}" class="success-page">
  <view class="success-card">
    <view class="success-icon">✓</view>
    <text class="success-title">提交成功</text>
    <text class="success-info">{{submittedData.department}} - {{submittedData.room}}</text>
    <view class="success-score">
      <text class="score-label">得分:</text>
      <text class="score-value">{{submittedData.totalScore}}</text>
    </view>

    <view class="progress-hint">
      <text class="progress-text">今日检查进度 {{submittedData.scoredCount}}/{{submittedData.totalOffices}}</text>
    </view>

    <view class="success-actions">
      <button class="action-btn primary" bindtap="viewDetail">查看详情</button>
      <button class="action-btn secondary" bindtap="continueScore">继续打分</button>
    </view>
  </view>
</view>
