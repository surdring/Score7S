/* pages/analytics/analytics.wxss */

.container {
  padding: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 头部 */
.header {
  margin-bottom: 32rpx;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
}

/* 图表卡片 */
.chart-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.chart-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chart-icon {
  font-size: 36rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.chart-hint {
  display: block;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 16rpx;
}

.chart-body {
  margin-top: 24rpx;
}

/* 趋势列表 */
.trend-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trend-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.trend-date {
  width: 120rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.trend-bar-container {
  flex: 1;
  height: 24rpx;
  background-color: #F3F4F6;
  border-radius: 12rpx;
  overflow: hidden;
}

.trend-bar {
  height: 100%;
  background: linear-gradient(90deg, #3B82F6 0%, #6366F1 100%);
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.trend-score {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 500;
  color: #3B82F6;
}

/* 部门列表 */
.dept-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dept-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dept-name {
  width: 180rpx;
  font-size: 24rpx;
  color: #374151;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dept-bar-container {
  flex: 1;
  height: 24rpx;
  background-color: #F3F4F6;
  border-radius: 12rpx;
  overflow: hidden;
}

.dept-bar {
  height: 100%;
  background: linear-gradient(90deg, #6366F1 0%, #8B5CF6 100%);
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.dept-score {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 500;
  color: #6366F1;
}

/* 问题项列表 */
.issue-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.issue-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.issue-name {
  width: 140rpx;
  font-size: 24rpx;
  color: #374151;
}

.issue-bar-container {
  flex: 1;
  height: 24rpx;
  background-color: #F3F4F6;
  border-radius: 12rpx;
  overflow: hidden;
}

.issue-bar {
  height: 100%;
  background: linear-gradient(90deg, #F97316 0%, #F59E0B 100%);
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.issue-bar.danger {
  background: linear-gradient(90deg, #EF4444 0%, #F97316 100%);
}

.issue-score {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 500;
  color: #F97316;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #3B82F6;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
}
