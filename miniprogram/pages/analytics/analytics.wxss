/* pages/analytics/analytics.wxss - 7S管理分析仪表盘 */

.container {
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  background-color: #F4F6F8;
}

/* ========== 1. 关键指标概览 ========== */
.health-overview {
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  border-radius: 24rpx;
  padding: var(--card-padding);
  margin-bottom: var(--card-gap);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(59, 130, 246, 0.3);
}

.overview-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.overview-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 400;
}

/* 关键指标概览头部布局 */
.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.overview-title-area {
  flex: 1;
}

/* 关键指标概览中的时间筛选器（胶囊样式） */
.time-filter-overview {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.filter-text-overview {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.filter-arrow-overview {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

.kpi-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 0;
  position: relative;
}

.kpi-grid::before {
  content: '';
  position: absolute;
  left: 66.666%;
  top: 20rpx;
  bottom: 20rpx;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.15);
}

.kpi-card {
  padding: 24rpx 28rpx;
  background: transparent;
  border: none;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* 左侧大卡片 - 综合均分 */
.kpi-main {
  justify-content: space-between;
  min-height: 160rpx;
}

.kpi-value-main {
  font-size: 64rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;
  line-height: 1;
  margin: 16rpx 0;
  transition: color 0.3s ease;
}

/* 右侧小卡片 - 环比 */
.kpi-side {
  justify-content: space-between;
  min-height: 160rpx;
}

.kpi-value-side {
  font-size: 40rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;
  line-height: 1;
  margin: 16rpx 0;
  transition: color 0.3s ease;
}

/* 状态色 - 综合均分 - 去掉背景，仅数字变色 */
.kpi-card.excellent .kpi-value-main {
  color: #34D399;
  text-shadow: 0 0 30rpx rgba(52, 211, 153, 0.4);
}

.kpi-card.good .kpi-value-main {
  color: #60A5FA;
}

/* 低于目标：警告橙黄色 */
.kpi-card.pass .kpi-value-main {
  color: #FBBF24;
  text-shadow: 0 0 20rpx rgba(251, 191, 36, 0.3);
}

.kpi-card.fail .kpi-value-main {
  color: #F87171;
  text-shadow: 0 0 20rpx rgba(248, 113, 113, 0.3);
}

/* 状态色 - 环比变化 */
.kpi-card.positive .kpi-value-side {
  color: #34D399;
}

.kpi-card.negative .kpi-value-side {
  color: #F87171;
}

.kpi-card.neutral .kpi-value-side {
  color: rgba(255, 255, 255, 0.5);
}

/* 矢量图标 - 加粗 */
.kpi-icon-svg {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.8;
}

/* 仪表盘图标 - Gauge/Speedometer */
.icon-gauge {
  width: 40rpx;
  height: 32rpx;
  position: relative;
}

/* 仪表盘半圆弧线 */
.icon-gauge::before {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 16rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.7);
  border-bottom: none;
  border-radius: 32rpx 32rpx 0 0;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* 仪表盘指针 - 指向右侧 */
.icon-gauge::after {
  content: '';
  position: absolute;
  width: 3rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 2rpx;
  bottom: 8rpx;
  left: 50%;
  transform-origin: bottom center;
  transform: translateX(-50%) rotate(35deg);
}

/* 趋势箭头图标 - 环比（涨↗ 跌↘ 平→） */
.icon-trend {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

/* 基础横向箭头（持平 →） */
.icon-trend::before {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 2rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.icon-trend::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 7rpx solid rgba(255, 255, 255, 0.6);
  border-top: 5rpx solid transparent;
  border-bottom: 5rpx solid transparent;
  top: 50%;
  right: 2rpx;
  transform: translateY(-50%);
}

/* 上升趋势 - 向右上箭头 ↗（绿色） */
.icon-trend.up::before {
  width: 22rpx;
  height: 4rpx;
  background: #34D399;
  transform: translate(-45%, -20%) rotate(-35deg);
  transform-origin: left center;
}

.icon-trend.up::after {
  border-left-color: #34D399;
  border-left-width: 9rpx;
  border-top-width: 6rpx;
  border-bottom-width: 6rpx;
  right: 4rpx;
  top: 35%;
}

/* 下降趋势 - 向右下箭头 ↘（红色） */
.icon-trend.down::before {
  width: 22rpx;
  height: 4rpx;
  background: #F87171;
  transform: translate(-45%, -80%) rotate(35deg);
  transform-origin: left center;
}

.icon-trend.down::after {
  border-left-color: #F87171;
  border-left-width: 9rpx;
  border-top-width: 6rpx;
  border-bottom-width: 6rpx;
  right: 4rpx;
  top: 65%;
}

/* 标签和目标值 */
.kpi-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.kpi-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
}

.kpi-target {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 400;
}

.trend-arrow {
  font-size: 28rpx;
  margin-right: 2rpx;
}

/* ========== 图表卡片通用样式 ========== */
.chart-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.06);
  border: 1rpx solid rgba(229, 231, 235, 0.8);
}

.chart-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  flex: 1;
}

/* 图表标题图标 - 统一尺寸和淡蓝底色 */
.chart-icon-svg {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(59, 130, 246, 0.08);
  border-radius: 50%;
  flex-shrink: 0;
}

/* 帕累托图标 - 递减阶梯+弧线 */
.icon-pareto {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

/* 三根递减柱子 */
.icon-pareto::before {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 20rpx;
  background: #3B82F6;
  border-radius: 2rpx;
  bottom: 0;
  left: 2rpx;
  box-shadow: 
    8rpx 4rpx 0 #3B82F6,
    16rpx 8rpx 0 #3B82F6;
}

/* 累计弧线 */
.icon-pareto::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 12rpx;
  border: 2rpx solid #3B82F6;
  border-bottom: none;
  border-radius: 24rpx 24rpx 0 0;
  top: 0;
  left: 0;
  opacity: 0.6;
}

/* 趋势图图标 - 带数据点的上升折线 */
.icon-trend-line {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

/* 上升折线 */
.icon-trend-line::before {
  content: '';
  position: absolute;
  width: 3rpx;
  height: 10rpx;
  background: #3B82F6;
  border-radius: 2rpx;
  bottom: 4rpx;
  left: 4rpx;
  transform: rotate(-45deg);
  transform-origin: bottom left;
  box-shadow: 8rpx -8rpx 0 #3B82F6;
}

/* 数据点 */
.icon-trend-line::after {
  content: '';
  position: absolute;
  width: 5rpx;
  height: 5rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
  background: transparent;
  top: 6rpx;
  right: 4rpx;
  box-shadow: -10rpx 10rpx 0 -1rpx #3B82F6;
}

.chart-hint {
  display: block;
  font-size: 24rpx;
  color: rgba(107, 114, 128, 0.85);
  margin-bottom: 16rpx;
}

.chart-body {
  margin-top: 16rpx;
}

/* ========== 2. 雷达图容器（已删除）========== */
.radar-container, .line-container, .pareto-container {
  width: 100%;
  height: 460rpx;
  display: block;
  position: relative;
}

.canvas-container {
  width: 100%;
  height: 460rpx;
  display: block;
  position: relative;
}

.ec-canvas,
.echarts-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.insight-card,
.insight-card.pareto-insight-card,
.insight-card-v2 {
  display: flex;
  align-items: flex-start;
  margin: 20rpx 0;
  padding: 24rpx 30rpx;
  border-radius: 12rpx;
}

.insight-card {
  background: #f8fbff;
  border-left: 8rpx solid #007bff;
  box-shadow: 0 2rpx 10rpx rgba(0, 123, 255, 0.05);
}

.insight-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.insight-content {
  flex: 1;
}

.insight-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #007bff;
  margin-bottom: 8rpx;
  display: block;
}

.insight-text {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
}

.suggestion-item {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #d1e9ff;
  font-style: italic;
  color: #6b7280;
}

.pareto-container {
  width: 100%;
  height: 500rpx;
}

.pareto-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pareto-rank {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #EF4444 0%, #F97316 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.pareto-info {
  flex: 1;
}

.pareto-name {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 8rpx;
}

.pareto-bar-container {
  height: 16rpx;
  background-color: #F3F4F6;
  border-radius: 8rpx;
  overflow: hidden;
}

.pareto-bar {
  height: 100%;
  background: linear-gradient(90deg, #EF4444 0%, #F97316 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.pareto-percent {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #EF4444;
}

.pareto-insight {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(90deg, #FEE2E2 0%, #FEF3C7 100%);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #991B1B;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ========== 4. 趋势折线图 ========== */
.line-container {
  width: 100%;
  height: 400rpx;
}

/* 时间筛选器样式（趋势图用 - 浅色背景） */
.time-filter {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  margin-left: auto;
}

.filter-text {
  font-size: 24rpx;
  color: #3B82F6;
  font-weight: 500;
}

.filter-arrow {
  font-size: 20rpx;
  color: #6B7280;
}

/* 帕累托优化建议卡片 - 蓝色边框匹配图表 */
.insight-card.pareto-insight-card {
  background: #f8fbff;
  border-left: 6rpx solid #3B82F6;
  box-shadow: 0 2rpx 10rpx rgba(59, 130, 246, 0.08);
}

.insight-card.pareto-insight-card .insight-title {
  color: #3B82F6;
}

/* 趋势解读卡片 V2 - 极简风格，深蓝色细边框 */
.insight-card-v2 {
  background: transparent;
  border-left: 4rpx solid #3B82F6;
}

.insight-card-v2 .insight-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3B82F6;
  margin-bottom: 12rpx;
  display: block;
}

.insight-card-v2 .insight-text {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.7;
}

/* 趋势解读图标 - 改为深蓝色 */
.icon-trend-up {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.icon-trend-up::before {
  content: '';
  position: absolute;
  width: 3rpx;
  height: 20rpx;
  background: #3B82F6;
  border-radius: 2rpx;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}

.icon-trend-up::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 12rpx solid #3B82F6;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* ========== 6. 异常穿透 ========== */
.exception-card .chart-header {
  cursor: pointer;
}

.exception-badge {
  background-color: #EF4444;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.toggle-arrow {
  margin-left: auto;
  font-size: 20rpx;
  color: #9CA3AF;
  transition: transform 0.3s ease;
}

.toggle-arrow.expanded {
  transform: rotate(180deg);
}

.exception-summary {
  padding: 16rpx 20rpx;
  background-color: #FEF2F2;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 16rpx;
}

.exception-summary .highlight {
  color: #EF4444;
  font-weight: 700;
}

.exception-list {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.exception-list.show {
  max-height: 1000rpx;
}

.exception-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: #F9FAFB;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.exception-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.exception-dept {
  font-size: 22rpx;
  color: #6B7280;
}

.exception-room {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.exception-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.exception-score .score-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #EF4444;
}

.exception-score .score-unit {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* ========== 7. 快速统计卡片 ========== */
.stats-card {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #3B82F6;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
}

/* ========== 加载与空状态 ========== */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #E5E7EB;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #374151;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #9CA3AF;
}
