<!--pages/analytics/analytics.wxml - 7S管理分析仪表盘-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
  </view>

  <!-- 无数据 -->
  <view wx:elif="{{!hasData}}" class="empty-state">
    <view class="empty-icon-line icon-data-folder"></view>
    <text class="empty-text">暂无足够的数据生成图表</text>
  </view>

  <!-- 有数据 -->
  <view wx:else class="charts-container">
    <!-- ========== 1. 关键指标概览（KPI 卡片）========== -->
    <view class="health-overview">
      <view class="overview-header">
        <view class="overview-title-area">
          <view class="overview-title">关键指标概览</view>
          <view class="overview-hint">聚合均分、变化趋势与目标对照</view>
        </view>
        <view class="time-filter-overview" bindtap="showTimeFilter">
          <text class="filter-text-overview">{{timeRangeText}}</text>
          <text class="filter-arrow-overview">▼</text>
        </view>
      </view>
      <view class="kpi-grid">
        <!-- 左侧大卡片：综合均分（占2/3） -->
        <view class="kpi-card kpi-main {{healthOverview.overallAverage >= 90 ? 'excellent' : (healthOverview.overallAverage >= 80 ? 'good' : (healthOverview.overallAverage >= 60 ? 'pass' : 'fail'))}}">
          <view class="kpi-icon-svg">
            <view class="icon-gauge"></view>
          </view>
          <view class="kpi-value-main">{{healthOverview.overallAverage}}</view>
          <view class="kpi-label-row">
            <text class="kpi-label">均分</text>
            <text class="kpi-target">目标 90</text>
          </view>
        </view>
        <!-- 右侧小卡片：环比变化（占1/3） -->
        <view class="kpi-card kpi-side {{healthOverview.weekOverWeekChange > 0 ? 'positive' : (healthOverview.weekOverWeekChange < 0 ? 'negative' : 'neutral')}}">
          <view class="kpi-icon-svg">
            <view class="icon-trend {{healthOverview.weekOverWeekChange > 0 ? 'up' : (healthOverview.weekOverWeekChange < 0 ? 'down' : '')}}"></view>
          </view>
          <view class="kpi-value-side">
            <text class="trend-arrow">{{healthOverview.weekOverWeekChange > 0 ? '↑' : (healthOverview.weekOverWeekChange < 0 ? '↓' : '')}}</text>
            {{healthOverview.weekOverWeekChange > 0 ? '+' : ''}}{{healthOverview.weekOverWeekChange}}%
          </view>
          <view class="kpi-label">环比变化</view>
        </view>
      </view>
    </view>

    <!-- ========== 2. 低分预警（提前至概览下方）========== -->
    <view class="chart-card exception-card" wx:if="{{unqualifiedOffices.length > 0}}">
      <view class="chart-header" bindtap="toggleExceptionList">
        <text class="chart-icon">⚠️</text>
        <view class="chart-accent"></view>
        <text class="chart-title">低分预警</text>
        <view class="exception-badge">{{unqualifiedOffices.length}}</view>
        <text class="toggle-arrow {{showExceptionList ? 'expanded' : ''}}">▼</text>
      </view>
      <view class="exception-summary">
        本周期有 <text class="highlight">{{unqualifiedOffices.length}}</text> 个办公室未达标
      </view>
      <view class="exception-list {{showExceptionList ? 'show' : ''}}" wx:if="{{showExceptionList}}">
        <view wx:for="{{unqualifiedOffices}}" wx:key="room" class="exception-item">
          <view class="exception-info">
            <text class="exception-dept">{{item.department}}</text>
            <text class="exception-room">{{item.room}}</text>
          </view>
          <view class="exception-score" style="color: {{item.totalScore < 60 ? '#EF4444' : '#F59E0B'}}">
            <text class="score-value">{{item.totalScore}}</text>
            <text class="score-unit">分</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== 3. 帕累托分析：扣分 Top 3 ========== -->
    <view class="chart-card">
      <view class="chart-header">
        <view class="chart-icon-svg icon-pareto"></view>
        <text class="chart-title">帕累托分析：扣分分布</text>
      </view>
      <view class="canvas-container">
        <canvas type="2d" id="paretoChart" class="echarts-canvas"></canvas>
      </view>
      <view class="insight-card pareto-insight-card" wx:if="{{paretoInsight}}">
        <view class="insight-icon-svg icon-target"></view>
        <view class="insight-content">
          <text class="insight-title">优化建议</text>
          <text class="insight-text">{{paretoInsight}}</text>
        </view>
      </view>
    </view>

    <!-- ========== 4. 动态趋势稳定性分析 ========== -->
    <view class="chart-card">
      <view class="chart-header">
        <view class="chart-icon-svg icon-trend-line"></view>
        <text class="chart-title">7S 综合平均分趋势</text>
      </view>
      <view class="chart-body line-container">
        <canvas type="2d" id="lineChart" class="ec-canvas"></canvas>
      </view>
      
      <!-- 趋势解读卡片 -->
      <view class="insight-card-v2 trend-insight-card-v2" wx:if="{{trendInsight}}">
        <view class="insight-icon-svg icon-trend-up"></view>
        <view class="insight-content">
          <text class="insight-title">趋势解读</text>
          <text class="insight-text">{{trendInsight}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
