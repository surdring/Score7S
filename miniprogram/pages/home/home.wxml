<!--pages/home/home.wxml-->
<view class="container">
  <!-- 头部标题 - 卡片式蓝紫渐变 -->
  <view class="header">
    <view class="header-content">
      <!-- 左侧：标题和副标题 -->
      <view class="header-left">
        <text class="header-title">最新联查概览</text>
        <text class="header-subtitle">现场红黑榜及核心动态摘要</text>
      </view>
      <!-- 右侧：日期选择器 -->
      <view class="date-selector">
        <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
          <view class="date-picker-btn">
            <view class="date-icon"></view>
            <text class="date-text">{{selectedDate || '选择日期'}}</text>
            <text class="date-arrow">▾</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
  </view>

  <!-- 红榜 -->
  <view wx:if="{{!loading}}" class="section">
    <view class="section-header">
      <view class="header-left">
        <view class="section-icon red"></view>
      </view>
      <text class="section-title">红榜</text>
      <text class="section-subtitle">优秀办公室</text>
    </view>

    <view wx:if="{{redList.length === 0}}" class="empty-card">
      <text class="empty-icon">✨</text>
      <text class="empty-text">暂无红榜数据</text>
      <text class="empty-hint">本期还没有产生高分办公室</text>
    </view>

    <view wx:else class="rank-list">
      <view 
        wx:for="{{redList}}" 
        wx:key="_id" 
        class="rank-card {{item.totalScore === 100 ? 'perfect' : 'red'}} clickable"
        bindtap="viewDetail"
        data-id="{{item._id}}"
      >
        <view class="rank-number-bg">{{item.rank}}</view>
        <view class="card-content">
          <view class="rank-info">
            <text class="rank-office">{{item.room}}</text>
            <text class="rank-dept">{{item.department}}</text>
          </view>
          <view class="rank-score {{item.totalScore === 100 ? 'perfect' : 'red'}}">{{item.totalScore}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 黑榜 -->
  <view wx:if="{{!loading}}" class="section">
    <view class="section-header">
      <view class="header-left">
        <view class="section-icon black"></view>
      </view>
      <text class="section-title">黑榜</text>
      <text class="section-subtitle">待改进</text>
    </view>

    <view wx:if="{{blackList.length === 0}}" class="empty-card">
      <text class="empty-icon">🎉</text>
      <text class="empty-text">暂无黑榜数据</text>
      <text class="empty-hint">大家表现都很棒，继续保持！</text>
    </view>

    <view wx:else class="rank-list">
      <view 
        wx:for="{{blackList}}" 
        wx:key="_id" 
        class="rank-card black clickable"
        bindtap="viewBlackDetail"
        data-id="{{item._id}}"
      >
        <view class="rank-number-bg danger">{{item.reverseRank}}</view>
        <view class="card-content">
          <view class="rank-info">
            <text class="rank-office">{{item.room}}</text>
            <text class="rank-dept">{{item.department}}</text>
          </view>
          <view class="rank-score black">{{item.totalScore}}</view>
        </view>
      </view>
      
      <!-- 榜单说明作为底部备注 -->
      <view wx:if="{{blackList.length < 3}}" class="rank-footer">
        <text>本期满分或与红榜同分的办公室较多，黑榜仅显示{{blackList.length}}个</text>
      </view>
    </view>
  </view>

  <!-- 本期提示 -->
  <view wx:if="{{!loading && (redList.length > 0 || blackList.length > 0)}}" class="insight-card">
    <view class="insight-header">
      <view class="insight-icon"></view>
      <text class="insight-title">本期提示</text>
    </view>
    <view class="insight-content">
      <block wx:if="{{insightData.perfectCount > 0}}">
        <text>本期共有 </text>
        <text class="count-highlight">{{insightData.perfectCount}}</text>
        <text> 间办公室得满分</text>
        <block wx:if="{{insightData.topOfficeNames}}">
          <text>；</text>
          <text class="office-highlight" bindtap="viewTopOffice">{{insightData.topOfficeNames}}</text>
          <text>本期并列榜首</text>
        </block>
      </block>
      <block wx:elif="{{insightData.topOfficeNames}}">
        <text class="office-highlight" bindtap="viewTopOffice">{{insightData.topOfficeNames}}</text>
        <block wx:if="{{insightData.topOfficeCount > 1}}">
          <text>本期并列榜首（{{insightData.topScore}}分）</text>
        </block>
        <block wx:else>
          <text>本期位列榜首（{{insightData.topScore}}分）</text>
        </block>
      </block>
      <block wx:if="{{insightData.blackOfficeNames}}">
        <text>；</text>
        <text class="office-highlight" bindtap="viewBlackFirst">{{insightData.blackOfficeNames}}</text>
        <block wx:if="{{insightData.blackOfficeCount > 1}}">
          <text>本期并列榜尾（{{insightData.blackScore}}分），需要重点关注，建议督导干预</text>
        </block>
        <block wx:else>
          <text>本期位列榜尾（{{insightData.blackScore}}分），需要重点关注，建议督导干预</text>
        </block>
      </block>
    </view>
  </view>
</view>

<!-- 密码弹窗 -->
<view 
  wx:if="{{showPasswordModal}}" 
  class="modal-mask" 
  catchtouchmove="preventTouchMove"
>
  <view class="password-modal">
    <view class="password-modal-header">
      <text class="password-modal-title">管理入口验证</text>
      <view class="modal-close" bindtap="cancelPasswordModal">✕</view>
    </view>
    <view class="password-modal-body">
      <text class="password-hint">请输入管理密码</text>
      <input 
        class="password-input"
        type="password"
        placeholder="请输入密码"
        value="{{passwordInput}}"
        bindinput="onPasswordInput"
        focus="{{passwordInputFocus}}"
        adjust-position="{{false}}"
      />
    </view>
    <view class="password-modal-footer">
      <button class="btn-cancel" bindtap="cancelPasswordModal">取消</button>
      <button class="btn-confirm" bindtap="confirmPassword" loading="{{passwordVerifying}}">确认</button>
    </view>
  </view>
</view>

<!-- 详情弹窗 -->
<view wx:if="{{showDetail}}" class="modal-mask" bindtap="closeDetail">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <view class="modal-title">
        <text class="modal-dept">{{selectedInspection.department}}</text>
        <text class="modal-subtitle">{{selectedInspection.room}} - {{selectedInspection.date}}</text>
      </view>
      <view class="modal-score-badge {{selectedInspection.totalScore < 60 ? 'danger' : ''}}">
        <text class="badge-value">{{selectedInspection.totalScore}}</text>
        <text class="badge-label">分</text>
      </view>
      <view class="modal-close" bindtap="closeDetail">✕</view>
    </view>

    <scroll-view scroll-y class="modal-body">
      <view wx:if="{{deductionItems.length === 0}}" class="empty-state">
        <text class="empty-status-icon">✅</text>
        <text>所有项目均获满分</text>
      </view>

      <view wx:else class="deduction-list">
        <view wx:for="{{deductionItems}}" wx:key="item" class="deduction-card {{item.level}}">
          <view class="deduction-header">
            <view class="deduction-item-info">
              <text class="deduction-item">{{item.item}}</text>
              <text class="deduction-diff">(-{{item.diff}}分)</text>
            </view>
            <view class="deduction-score-box">
              <text class="score-current">{{item.score}}</text>
              <text class="score-total">/{{item.maxScore}}分</text>
            </view>
          </view>
          
          <view wx:if="{{item.remark}}" class="deduction-remark">
            <text class="remark-prefix">📝 备注：</text>
            <text>{{item.remark}}</text>
          </view>
          
          <view wx:if="{{item.images.length > 0}}" class="deduction-images">
            <image 
              wx:for="{{item.images}}" 
              wx:for-item="img" 
              wx:for-index="idx"
              wx:key="idx"
              src="{{img}}" 
              class="deduction-image"
              mode="aspectFill"
              bindtap="previewImage"
              data-url="{{img}}"
              data-urls="{{item.images}}"
            />
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
