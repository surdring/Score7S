/* pages/home/home.wxss - 7S联查看板仪表盘 */

.container {
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  background-color: #F5F7FA;
}

/* ========== 1. 顶部Header：蓝紫渐变 + 卡片式 + 标题布局 ========== */
.header {
  padding: var(--card-padding);
  margin: 0 0 var(--card-gap);
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(59, 130, 246, 0.25);
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 左侧标题区域 */
.header .header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-start;
  text-align: left;
}

.header-title {
  display: block;
  width: 100%;
  text-align: left;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.header-subtitle {
  display: block;
  width: 100%;
  text-align: left;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 400;
}

/* 日期选择器 - 胶囊样式 */
.date-selector {
  display: flex;
  justify-content: flex-end;
}

.date-picker-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 14rpx 20rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.2s;
}

.date-picker-btn:active {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(0.98);
}

/* 线性日历图标 */
.date-icon {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 4rpx;
  position: relative;
  flex-shrink: 0;
}

.date-icon::after {
  content: '';
  position: absolute;
  width: 6rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.9);
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 3rpx 0 rgba(255, 255, 255, 0.9);
}

.date-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.date-arrow {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ========== 2. 栏目标题：极简线性图标 ========== */
.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-header .header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 已删除.section-bar样式 - 深蓝垂直装饰线已移除 */

/* 线性图标 - 红榜：靶心 (珊瑚浅红) */
.section-icon.red {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.section-icon.red::before {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #F87171;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.section-icon.red::after {
  content: '';
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #F87171;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 线性图标 - 黑榜：放大镜 (炭黑色) */
.section-icon.black {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.section-icon.black::before {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid #2D3436;
  border-radius: 50%;
  top: 6rpx;
  left: 4rpx;
}

.section-icon.black::after {
  content: '';
  position: absolute;
  width: 2rpx;
  height: 10rpx;
  background: #2D3436;
  bottom: 4rpx;
  right: 6rpx;
  transform: rotate(-45deg);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.section-subtitle {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-left: auto;
  font-weight: 400;
}

/* 空状态卡片 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
  background-color: #FFFFFF;
  border: 4rpx dashed #E5E7EB;
  border-radius: 24rpx;
  text-align: center;
}

.empty-card .empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.empty-card .empty-text {
  font-size: 32rpx;
  color: #374151;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-card .empty-hint {
  font-size: 26rpx;
  color: #9CA3AF;
}

/* ========== 3. 红黑榜卡片：办公室粒度 + 背景数字 ========== */

/* 排行榜列表 - 20rpx间距 */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 排行榜卡片 - 超大淡阴影 */
.rank-card {
  display: flex;
  align-items: center;
  padding: 0;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.03);
  position: relative;
  overflow: hidden;
}

/* 3px极简直线 - 红榜珊瑚浅红 */
.rank-card.red::before,
.rank-card.perfect::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: #F87171;
}

/* 3px极简直线 - 黑榜炭黑 */
.rank-card.black::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: #2D3436;
}

/* 红榜卡片：淡粉背景 */
.rank-card.red {
  background: linear-gradient(90deg, #FFF5F5 0%, #FFFFFF 30%);
}

/* 满分卡片：珊瑚红发光侧边条 */
.rank-card.perfect::before {
  box-shadow: 0 0 20rpx rgba(248, 113, 113, 0.4);
}

.rank-card.clickable:active {
  background-color: #F9FAFB;
  transform: scale(0.995);
}

/* 背景数字 - 提升可见度，平衡简约与可读性 */
.rank-number-bg {
  width: 100rpx;
  min-width: 100rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;
  color: rgba(248, 113, 113, 0.2);
  flex-shrink: 0;
  padding: 0 16rpx;
  line-height: 1;
}

/* 黑榜排名数字 - 炭黑色15%透明度 */
.rank-number-bg.danger {
  color: rgba(45, 52, 54, 0.15);
}

/* 第一名特殊处理 - 极淡圆形底色突出状元地位 */
.rank-card:first-child .rank-number-bg {
  position: relative;
}

.rank-card:first-child .rank-number-bg::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: rgba(248, 113, 113, 0.06);
  z-index: -1;
}

.rank-card.black:first-child .rank-number-bg::before {
  background: rgba(45, 52, 54, 0.04);
}

/* 卡片内容区域 */
.card-content {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx 24rpx 12rpx;
  min-width: 0;
}

/* 排名信息 - 办公室主标题 + 部门辅助 */
.rank-info {
  flex: 1;
  min-width: 0;
}

/* 办公室名称 - 主标题 (15px/30rpx) */
.rank-office {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6rpx;
  line-height: 1.4;
  word-wrap: break-word;
  word-break: break-all;
}

/* 部门名称 - 辅助标签 (12px/24rpx，钛灰) */
.rank-dept {
  display: block;
  font-size: 24rpx;
  color: #636E72;
  line-height: 1.3;
}

/* 分数 - DIN字体，裸奔大数字 */
.rank-score {
  min-width: 100rpx;
  text-align: right;
  font-size: 44rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 红榜分数 - 珊瑚浅红 */
.rank-score.red,
.rank-score.perfect {
  color: #F87171;
}

/* 黑榜分数 - 炭黑色 */
.rank-score.black {
  color: #2D3436;
}

/* 榜单底部备注 */
.rank-footer {
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  color: #9CA3AF;
  text-align: center;
}

/* ========== 4. 今日管理速报卡片（莫兰迪配色） ========== */
.insight-card {
  margin: 40rpx 0 48rpx 0;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFFFFF 100%);
  border-radius: 16rpx;
  border-left: 3rpx solid #F87171;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.03);
}

.insight-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

/* 线性灯泡图标 (珊瑚浅红) */
.insight-icon {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.insight-icon::before {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #F87171;
  border-radius: 50%;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.insight-icon::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 6rpx;
  border: 2rpx solid #F87171;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
}

.insight-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #F87171;
}

.insight-content {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.8;
}

/* 可点击办公室名 - 炭黑强调 */
.office-highlight {
  color: #2D3436;
  font-weight: 600;
}

.office-highlight:active {
  opacity: 0.7;
}

/* 数量高亮 - 珊瑚浅红 */
.count-highlight {
  color: #F87171;
  font-weight: 600;
}

/* 模态框 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal-content {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #E5E7EB;
  background-color: #F9FAFB;
  border-radius: 32rpx 32rpx 0 0;
}

.modal-title {
  flex: 1;
}

.modal-score-badge {
  display: flex;
  align-items: baseline;
  background-color: #ECFDF5;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.modal-score-badge.danger {
  background-color: #FEF2F2;
}

.modal-score-badge .badge-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #059669;
}

.modal-score-badge.danger .badge-value {
  color: #DC2626;
}

.modal-score-badge .badge-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-left: 4rpx;
}

.modal-dept {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  font-size: 28rpx;
  color: #6B7280;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
  background-color: #F3F4F6;
}

/* 扣分项卡片强化 */
.deduction-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.deduction-card {
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border-left: 8rpx solid #E5E7EB;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.deduction-card.perfect {
  border-left-color: #10B981;
}

.deduction-card.warning {
  border-left-color: #F59E0B;
}

.deduction-card.critical {
  border-left-color: #DC2626;
}

.deduction-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-right: 32rpx;
}

.deduction-item-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.deduction-item {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.deduction-diff {
  font-size: 24rpx;
  font-weight: 600;
  color: #DC2626;
  background-color: #FEF2F2;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.deduction-score-box {
  display: flex;
  align-items: baseline;
}

.score-current {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.critical .score-current {
  color: #DC2626;
}

.warning .score-current {
  color: #F59E0B;
}

.perfect .score-current {
  color: #10B981;
}

.score-total {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-left: 4rpx;
}

.deduction-remark {
  padding: 16rpx 20rpx;
  background-color: #F9FAFB;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.5;
  margin-bottom: 20rpx;
  border-left: 4rpx solid #D1D5DB;
}

.remark-prefix {
  font-weight: 600;
  color: #374151;
}

.deduction-images {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.deduction-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E5E7EB;
}

/* 空状态优化 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #9CA3AF;
}

.empty-status-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

/* 密码弹窗样式 */
.password-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  z-index: 1001;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.password-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background-color: #F9FAFB;
  border-bottom: 2rpx solid #E5E7EB;
}

.password-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.password-modal-body {
  padding: 40rpx 32rpx;
}

.password-hint {
  display: block;
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 24rpx;
}

.password-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.password-input:focus {
  border-color: #3B82F6;
}

.password-modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 32rpx;
}

.btn-cancel {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6B7280;
  background-color: #F3F4F6;
  border: none;
  border-radius: 16rpx;
}

.btn-confirm {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  background-color: #3B82F6;
  border: none;
  border-radius: 16rpx;
}

.btn-confirm[loading] {
  opacity: 0.7;
}
