{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2017"],
    "typeRoots": ["./node_modules/miniprogram-api-typings", "./typings"]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cloudfunctions"
  ]
}
